# Set ONE of these to enable live LLM mode. Without either, the app runs
# fully in mock mode (deterministic fallback, no API calls, no cost).
#
# Preference order if both are set: Groq first, then Claude.

# Groq (recommended) -- generous free tier, no credit card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here

# Claude -- used only if GROQ_API_KEY is not set.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
